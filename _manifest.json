{
  "manifest_version": 2,
  "id": "github.SoulString-Dev.maibot-mimo-voice",
  "version": "0.5.2",
  "name": "MiMo TTS 语音回复",
  "description": "用 MiMo API 音色克隆把文本回复按比例换成语音：内置理塘王、MiMo 默认女角色音色，可换自定义参考音频；含朗读清洗与风格指令、音色对齐与尾音修正，随机/模型请求双触发，超时自动回退文字。",
  "author": {
    "name": "SoulString",
    "url": "https://github.com/SoulString-Dev"
  },
  "license": "MIT",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/SoulString-Dev/maibot-mimo-voice",
    "homepage": "https://github.com/SoulString-Dev/maibot-mimo-voice",
    "documentation": "https://github.com/SoulString-Dev/maibot-mimo-voice/blob/main/README.md",
    "issues": "https://github.com/SoulString-Dev/maibot-mimo-voice/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.12.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "mic"
    }
  }
}

{
  "manifest_version": 2,
  "id": "github.SoulString-Dev.maibot-mimo-voice",
  "version": "0.5.2",
  "name": "MiMo 语音回复",
  "description": "用 MiMo 音色克隆把麦麦的纯文本回复按比例替换为语音：内置冰糖/茉莉/理塘王三套音色、可换自定义参考音频、朗读清洗与风格指令稳定音色、音色对齐与尾音修正、支持随机/模型请求双触发、超时自动回退文字。",
  "author": {
    "name": "SoulString",
    "url": "https://github.com/SoulString-Dev"
  },
  "license": "MIT",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/SoulString-Dev/maibot-mimo-voice",
    "homepage": "https://github.com/SoulString-Dev/maibot-mimo-voice",
    "documentation": "https://github.com/SoulString-Dev/maibot-mimo-voice/blob/main/README.md",
    "issues": "https://github.com/SoulString-Dev/maibot-mimo-voice/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.12.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "mic"
    }
  }
}
